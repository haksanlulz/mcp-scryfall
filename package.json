{
  "name": "mcp-scryfall",
  "version": "1.1.0",
  "type": "module",
  "description": "MCP (Model Context Protocol) server for live Magic: The Gathering card lookup via the Scryfall API.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "scryfall",
    "mtg",
    "magic-the-gathering",
    "llm",
    "ai"
  ],
  "license": "MIT",
  "author": "Abishai James",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/haksanlulz/mcp-scryfall.git"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "tsx index.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "smoke": "tsx smoke.ts",
    "build": "tsc -p tsconfig.build.json",
    "bundle": "node scripts/bundle.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0"
  },
  "devDependencies": {
    "@types/node": "^26.5.1",
    "tsx": "^4.23.13",
    "typescript": "^5.6.0",
    "vitest": "^4.1.11"
  }
}
